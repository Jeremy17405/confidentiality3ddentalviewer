# ─── Google Calendar ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://192.168.1.174:3000/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# ─── iCloud CardDAV ────────────────────────────────────────────────
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# ─── Clinique ──────────────────────────────────────────────────────
CLINIC_NAME=מרפאת שיניים
CLINIC_PHONE=+972

# ─── Rappels ───────────────────────────────────────────────────────
# Cron : tous les jours sauf samedi à 8h00 (0-5 = dim→ven)
REMINDER_CRON=0 8 * * 0-5

# Message WhatsApp (variables : {prenom}, {nom}, {date}, {heure}, {clinique}, {telephone})
REMINDER_MESSAGE=שלום {prenom},
תזכורת לתור שלך ב{clinique}
📅 {date} בשעה {heure}

לביטול או שינוי נא ליצור קשר: {telephone}
תודה ולהתראות! 🦷

# ─── Synchronisation ───────────────────────────────────────────────
# Polling Google Calendar (ms)
CALENDAR_POLL_INTERVAL=120000
# Sync iCloud contacts (ms)
ICLOUD_SYNC_INTERVAL=300000
# Score minimum matching (0-1)
MATCHING_THRESHOLD=0.72

# ─── Web ───────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_SECRET=changeme_mot_de_passe_fort

# ─── Base de données ───────────────────────────────────────────────
DB_PATH=./data/clinique.db
